# Copy to .env and fill in. Never commit .env.

# --- LLM provider abstraction -------------------------------------------------
# Which provider the agent uses: "gemini" (now) or "ollama" (added later).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Gemini API key (from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Ollama (local dev, added later)
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Database -----------------------------------------------------------------
# Local: from docker-compose. Prod: Neon connection string.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# --- Observability ------------------------------------------------------------
# Langfuse traces every agent run (steps, tool calls, tokens, latency, cost). Set both keys
# to enable it; leave them blank to run untraced. Cloud: https://cloud.langfuse.com (EU) or
# https://us.cloud.langfuse.com (US). Self-hosted: your own host, e.g. http://localhost:3001.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOGFIRE_TOKEN=

# --- Experiment tracking ------------------------------------------------------
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Auth (Next.js / Auth.js) -------------------------------------------------
NEXTAUTH_SECRET=
# Shared secret the frontend signs the backend Bearer JWT with; the backend verifies it.
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# --- App ----------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
DATA_DIR=./data
