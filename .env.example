# Copy to .env and fill in. Never commit .env.

# --- LLM provider abstraction -------------------------------------------------
# Which provider the agent uses: "gemini" (now) or "ollama" (added later).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Gemini API key (from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Ollama (local dev, added later)
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Database -----------------------------------------------------------------
# Local: from docker-compose. Prod: Neon connection string.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# --- Observability ------------------------------------------------------------
# Langfuse traces every agent run (steps, tool calls, tokens, latency, cost). Set both keys
# to enable it; leave them blank to run untraced. Cloud: https://cloud.langfuse.com (EU) or
# https://us.cloud.langfuse.com (US). Self-hosted: your own host, e.g. http://localhost:3001.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOGFIRE_TOKEN=

# --- Experiment tracking ------------------------------------------------------
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Auth (Next.js / Auth.js) -------------------------------------------------
# Session secret for Auth.js (generate: openssl rand -base64 32).
AUTH_SECRET=
# Shared secret the frontend signs the backend Bearer JWT with; the backend verifies it.
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
# Google OAuth credentials (from the Google Cloud console).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The app's own public url; set to the deployed origin in production.
AUTH_URL=http://localhost:3000
# Trust the proxy host header (needed behind a container/proxy).
AUTH_TRUST_HOST=true

# --- App ----------------------------------------------------------------------
# Backend url. NEXT_PUBLIC_API_URL is used by the browser (baked into the frontend build);
# API_BASE_URL is used by the Next server (e.g. a service name inside a container network).
NEXT_PUBLIC_API_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
# Origins the backend accepts cross-origin requests from (JSON list); add the deployed frontend.
CORS_ORIGINS=["http://localhost:3000"]
# Extra origins allowed to invoke Next server actions (comma-separated); add deployed host(s).
SERVER_ACTION_ORIGINS=
DATA_DIR=./data
