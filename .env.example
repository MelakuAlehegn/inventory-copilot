# Copy to .env and fill in. Never commit .env.

# --- LLM provider abstraction -------------------------------------------------
# Which provider the agent uses: "ollama" (dev) or "groq" (prod).
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct

# Ollama (local dev)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Groq (prod, OpenAI-compatible open-weight endpoint)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Database -----------------------------------------------------------------
# Local: from docker-compose. Prod: Neon connection string.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# --- Observability ------------------------------------------------------------
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOGFIRE_TOKEN=

# --- Experiment tracking ------------------------------------------------------
MLFLOW_TRACKING_URI=./backend/mlruns

# --- Auth (Next.js / Auth.js) -------------------------------------------------
NEXTAUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# --- App ----------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
DATA_DIR=./data
